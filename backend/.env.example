# Application URL and environment. Keep APP_DEBUG disabled in production.
APP_NAME=Laravel
APP_ENV=local
# Generate a unique key with `php artisan key:generate`.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Use `single` for a simple local log file; change LOG_LEVEL for production as needed.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is the local default. For MySQL, set DB_CONNECTION=mysql and configure DB_* below.
# DB_DATABASE is a database name for MySQL and a SQLite file path for SQLite.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=musik_aralan
DB_USERNAME=root
DB_PASSWORD=

# Certificate for enabling SSL on a required SSL MySQL database
MYSQL_ATTR_SSL_CA="/path/to/CA/cert"

# Database-backed sessions require the sessions table created by the migrations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Public-disk uploads are stored under storage/app/public; run `php artisan storage:link`.
FILESYSTEM_DISK=public
# Material uploads use this disk independently of FILESYSTEM_DISK.
# Use "s3" for AWS or "s3-compatible" for R2/Filebase and configure the AWS_* values below.
MATERIAL_UPLOADS_DISK=public
# Maximum direct teacher and student file upload size in MB.
MATERIAL_UPLOAD_MAX_SIZE_MB=8
# Enable for private buckets to generate signed download links.
MATERIAL_UPLOADS_SIGNED_URLS=false
# Signed-link lifetime when MATERIAL_UPLOADS_SIGNED_URLS is enabled.
MATERIAL_SIGNED_URL_TTL_MINUTES=60
# AWS credentials configure S3 storage and can also be used for SES mail delivery.
# AWS_URL is the public bucket or CDN base URL used by the material viewer.
# Set AWS_ENDPOINT and AWS_USE_PATH_STYLE_ENDPOINT as required by an S3-compatible provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_DEFAULT_VISIBILITY=public
# Database-backed queues require a running `php artisan queue:work` worker.
QUEUE_CONNECTION=database

# The database cache store requires the cache tables created by the migrations.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The log mailer does not deliver email; configure SMTP or another transport for real delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend origin allowed by the API's CORS configuration.
FRONTEND_URL=http://localhost:5173
# Optional: path to a Firebase service-account JSON file (relative to backend/ or absolute).
# Used only by the legacy Firestore importer, not for user authentication.
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

# Vite exposes this value to the frontend at build time.
VITE_APP_NAME="${APP_NAME}"
